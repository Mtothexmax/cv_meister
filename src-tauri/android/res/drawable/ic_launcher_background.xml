<?xml version="1.0" encoding="utf-8"?>
<!--
  Background layer of the adaptive launcher icon: the favicon's blue, full-bleed.

  Replaces the green Android Studio template vector that the generated project
  ships in this same path. The colour is the <rect fill> of
  src/lib/assets/favicon.svg; make-icons.sh reads it from there for the bitmaps,
  so if the favicon's colour changes this file has to follow.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#2563EB"
        android:pathData="M0,0h108v108h-108z" />
</vector>
