<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon (API 26+), derived from src/lib/assets/favicon.svg.

  The layers are 108x108 dp; the launcher shows the central 72x72 dp of that
  canvas and masks it to its own shape, so the background is full-bleed and the
  foreground carries only the letters. A rounded square drawn in here would show
  its own corners inside a circular mask.

  The bitmaps are generated by src-tauri/android/make-icons.sh — do not edit
  them by hand, and do not edit this file's geometry without re-running it.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <!-- Themed icons (Android 13+): the launcher tints the alpha mask. -->
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
